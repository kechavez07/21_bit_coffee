# Render deploy: paste these values manually in the Render dashboard
# (Environment tab). Never commit a real .env — this file only documents
# which keys exist.

# --- Firebase Admin credentials ---
# Render doesn't support uploading secret files, so the whole service
# account JSON goes in as one env var (a single-line JSON string).
# Get it from: Firebase Console > Project settings > Service accounts >
# Generate new private key.
# Not needed when running against the local emulator (see below).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project id. Always required.
FIREBASE_PROJECT_ID=bit-coffee-668f6

# --- Local emulator only (leave BOTH unset in Render/production) ---
# Set these to point firebase-admin at the local Firestore/Auth emulators
# instead of real Firebase. When set, FIREBASE_SERVICE_ACCOUNT_JSON is not
# needed.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8090
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- CORS ---
# Comma-separated list of exact production/preview origins allowed to
# call this API (no trailing slash) — e.g. the Vercel URL, plus a preview
# deploy URL if you have one. Any http(s)://localhost:<port> or
# 127.0.0.1:<port> origin is ALWAYS allowed regardless of this value —
# safe to leave permanent, since a browser only ever sends that Origin
# for requests genuinely made from a page served on localhost — so local
# dev keeps working no matter which port Vite lands on (see src/lib/cors.js).
# Placeholder until the first Vercel deploy exists.
ALLOWED_ORIGIN=https://TODO-your-app.vercel.app

# --- Server ---
# Render injects PORT automatically in production; only needed locally.
PORT=8081
