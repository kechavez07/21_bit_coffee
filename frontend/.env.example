# Firebase client SDK configuration.
# Copy this file to `.env` and fill in the values from your Firebase
# project settings (Project settings > General > Your apps > SDK setup).
# `.env` is gitignored — never commit real credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair (Phase 6) — generated once from Firebase
# Console: Project settings > Cloud Messaging > Web configuration > Web
# Push certificates. Required by `requestNotificationPermissionAndToken()`
# (frontend/src/services/firebase/messaging.ts) to call `getToken()`; there
# is no CLI/API way to generate this, it must be pasted in manually.
VITE_FIREBASE_VAPID_KEY=

# Opt-in: set to 'true' to point the app at the local Firebase emulator
# suite (Auth :9099, Firestore :8090 — see backend/firebase.json) instead
# of the real project. Leave unset/empty to use production as before. Run
# `firebase emulators:start --only firestore,auth` from `backend/` first.
VITE_USE_FIREBASE_EMULATOR=

# Base URL of the Express API (backend/server), no trailing slash.
# Local dev: http://localhost:8081
# Production: the Render service URL (only known after the first deploy —
# see README_MIGRACION.md).
VITE_API_URL=
